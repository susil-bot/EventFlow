# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port for the API
PORT=4000

# PostgreSQL connection string for the app
DATABASE_URL=postgres://postgres:postgres@localhost:5432/events_dev

# PostgreSQL connection string used by `npm test` (database is wiped per test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/events_test

# Secret used to sign session JWTs. Use a long random value (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars

# Session lifetime, in hours
SESSION_TTL_HOURS=12

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Folder for uploaded promo images (served at /uploads). Relative to apps/api.
UPLOAD_DIR=./uploads

# Maximum size of one uploaded image, in MB
MAX_UPLOAD_MB=5

# Sign-in / sign-up attempts allowed per IP per window (brute-force guard)
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Express "trust proxy" setting. Leave empty locally; set to 1 behind one
# reverse proxy (nginx, a load balancer) so client IPs are read correctly.
TRUST_PROXY=

# Send the session cookie only over HTTPS. Defaults to true when
# NODE_ENV=production. Set false only for a plain-HTTP local demo (the Docker
# stack sets it); Safari ignores Secure cookies on http://localhost.
# COOKIE_SECURE=
